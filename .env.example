# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://agentic_user:agentic_password@localhost:5432/agentic_sandbox
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agentic_sandbox
DB_USER=agentic_user
DB_PASSWORD=agentic_password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# OAuth Configuration
OAUTH_ISSUER=http://localhost:3000
OAUTH_CLIENT_ID=agentic-sandbox-client
OAUTH_CLIENT_SECRET=agentic-sandbox-secret
OAUTH_REDIRECT_URI=http://localhost:3000/callback

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# CORS Configuration
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true

# Data Generation
DATA_GEN_PROVIDER=faker
GRETEL_API_KEY=
TONIC_API_KEY=

# NetSuite Mock Configuration
NETSUITE_ACCOUNT_ID=TSTDRV123456
NETSUITE_BASE_URL=https://tstdrv123456.suitetalk.api.netsuite.com
NETSUITE_TOKEN_ID=mock-token-id
NETSUITE_TOKEN_SECRET=mock-token-secret

# Salesforce Mock Configuration
SALESFORCE_INSTANCE_URL=https://na1.salesforce.com
SALESFORCE_CLIENT_ID=mock-salesforce-client-id
SALESFORCE_CLIENT_SECRET=mock-salesforce-client-secret

# HubSpot Mock Configuration
HUBSPOT_CLIENT_ID=mock-hubspot-client-id
HUBSPOT_CLIENT_SECRET=mock-hubspot-client-secret

# QuickBooks Mock Configuration
QUICKBOOKS_CLIENT_ID=mock-quickbooks-client-id
QUICKBOOKS_CLIENT_SECRET=mock-quickbooks-client-secret
QUICKBOOKS_COMPANY_ID=123456789
