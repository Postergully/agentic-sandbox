{
  "name": "agentic-sandbox",
  "version": "1.0.0",
  "description": "Mock connector service for testing AI agents with enterprise systems",
  "main": "dist/index.js",
  "bin": {
    "mock-factory": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "migrate": "node-pg-migrate",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "cli": "ts-node src/cli/index.ts",
    "mock-factory": "ts-node src/cli/index.ts",
    "test:e2e:google": "npx ts-node scripts/test-google-workspace-e2e.ts",
    "test:e2e:netsuite": "npx ts-node scripts/test-netsuite-e2e.ts"
  },
  "keywords": [
    "ai-agents",
    "mock-api",
    "enterprise-connectors",
    "oauth",
    "synthetic-data"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@apidevtools/swagger-parser": "^12.1.0",
    "@fabricate-tools/client": "^1.4.0",
    "axios": "^1.13.4",
    "bcrypt": "^5.1.1",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "commander": "^14.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-rate-limit": "^7.1.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-sql-parser": "^5.4.0",
    "ora": "^9.2.0",
    "pg": "^8.11.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.10.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.1",
    "node-pg-migrate": "^6.2.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.2.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
