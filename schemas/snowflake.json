        {
          "name": "created_on",
          "type": "timestamp",
          "required": true,
          "snowflakeName": "CREATED_ON",
          "faker": "date.past"
        },
        {
          "name": "resumed_on",
          "type": "timestamp",
          "required": false,
          "snowflakeName": "RESUMED_ON",
          "faker": "date.recent"
        }
      ]
    },

