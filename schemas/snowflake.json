          "required": false,
          "snowflakeName": "MAX_CLUSTER_COUNT",
          "default": 1
        },
        {
          "name": "auto_suspend",
          "type": "integer",
          "required": false,
          "snowflakeName": "AUTO_SUSPEND",
          "default": 600,
          "description": "Auto-suspend timeout in seconds"
        },
        {
          "name": "auto_resume",
          "type": "boolean",
          "required": false,
          "snowflakeName": "AUTO_RESUME",
          "default": true
