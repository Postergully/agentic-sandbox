{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "connectorId": "snowflake",
  "connectorName": "Snowflake",
  "connectorType": "data_warehouse",
  "version": "1.0.0",
  "description": "Snowflake Data Cloud - SQL REST API mock server for AI agent testing",

  "authentication": {
    "type": "oauth2",
    "flows": ["client_credentials", "jwt_bearer"],
    "endpoints": {
      "token": "/oauth/token-request"
    },
    "fields": [
      "account_identifier",
      "client_id",
      "client_secret",
      "username",
      "role",
      "warehouse"
    ],
    "config": {
      "tokenType": "Bearer",
      "headerFormat": "Authorization: Bearer {access_token}"
    },
    "mockBehavior": {
      "acceptAnyCredentials": true,
      "tokenExpiresIn": 3600,
      "refreshTokenEnabled": true
    }
  },

  "baseUrl": "/api/v2",

  "entities": {
    "databases": {
      "table": "snowflake_databases",
      "snowflakeObjectName": "DATABASE",
      "description": "Snowflake database objects",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "required": true,
          "unique": true,
          "primaryKey": true,
          "faker": "string.uuid"
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "unique": true,
          "snowflakeName": "DATABASE_NAME",
          "faker": "helpers.arrayElement",
          "fakerArgs": [["PRODUCTION_DB", "ANALYTICS_DB", "STAGING_DB", "DEV_DB", "RAW_DATA_DB", "TRANSFORMED_DB"]]
        },
        {
          "name": "owner",
          "type": "string",
          "required": true,
          "snowflakeName": "DATABASE_OWNER",
          "default": "ACCOUNTADMIN"
        },
        {
          "name": "comment",
          "type": "string",
          "required": false,
          "snowflakeName": "COMMENT",
          "faker": "lorem.sentence"
        },
        {
          "name": "retention_time",
          "type": "integer",
          "required": false,
          "snowflakeName": "RETENTION_TIME",
          "default": 1
        },
        {
          "name": "is_transient",
          "type": "boolean",
          "required": false,
          "snowflakeName": "IS_TRANSIENT",
          "default": false
        },
        {
          "name": "is_current",
          "type": "boolean",
          "required": false,
          "snowflakeName": "IS_CURRENT",
          "default": false
        },
        {
          "name": "created_on",
          "type": "timestamp",
          "required": true,
          "snowflakeName": "CREATED_ON",
          "faker": "date.past"
        }
      ]
    },

    "schemas": {
      "table": "snowflake_schemas",
      "snowflakeObjectName": "SCHEMA",
      "description": "Snowflake schema objects within databases",
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "required": true,
          "unique": true,
          "primaryKey": true,
          "faker": "string.uuid"
        },
        {
          "name": "database_id",
          "type": "uuid",
          "required": true,
          "foreignKey": {
            "table": "snowflake_databases",
            "column": "id"
          }
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "snowflakeName": "SCHEMA_NAME",
          "faker": "helpers.arrayElement",
          "fakerArgs": [["PUBLIC", "RAW", "STAGING", "ANALYTICS", "REPORTING", "DIM", "FACT"]]
        },
        {
          "name": "owner",
          "type": "string",
          "required": true,
          "snowflakeName": "SCHEMA_OWNER",
          "default": "SYSADMIN"
        },
        {
          "name": "comment",
          "type": "string",
          "required": false,
          "snowflakeName": "COMMENT",
          "faker": "lorem.sentence"
        },
        {
          "name": "retention_time",
          "type": "integer",
          "required": false,
          "snowflakeName": "RETENTION_TIME",
          "default": 1
        },
        {
          "name": "is_transient",
          "type": "boolean",
          "required": false,
          "snowflakeName": "IS_TRANSIENT",
          "default": false
        },
        {
          "name": "is_managed_access",
          "type": "boolean",
          "required": false,
          "snowflakeName": "IS_MANAGED_ACCESS",
          "default": false
        },
        {
          "name": "created_on",
          "type": "timestamp",
          "required": true,
          "snowflakeName": "CREATED_ON",
          "faker": "date.past"
        }
      ]
    },

    "warehouses": {
      "table": "snowflake_warehouses",
      "snowflakeObjectName": "WAREHOUSE",
