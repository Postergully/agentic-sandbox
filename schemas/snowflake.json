  "endpoints": {
    "authentication": {
      "token": {
        "method": "POST",
        "path": "/oauth/token-request",
        "description": "Request OAuth access token",
        "requestBody": {
          "type": "object",
          "properties": {
            "grant_type": {
              "type": "string",
              "enum": ["client_credentials", "urn:ietf:params:oauth:grant-type:jwt-bearer"]
            },
            "client_id": { "type": "string" },
            "client_secret": { "type": "string" },
            "scope": { "type": "string" }
          },
          "required": ["grant_type"]
        },
        "response": {
          "type": "object",
          "properties": {
            "access_token": { "type": "string" },
            "token_type": { "type": "string" },
            "expires_in": { "type": "integer" },
            "refresh_token": { "type": "string" },
            "scope": { "type": "string" }
          }
        }
      }
    },
    "statements": {
      "executeStatement": {
        "method": "POST",
        "path": "/statements",
        "description": "Execute a SQL statement asynchronously",
        "requestBody": {
          "type": "object",
          "properties": {
            "statement": {
              "type": "string",
              "description": "SQL statement to execute"
            },
            "timeout": {
              "type": "integer",
              "description": "Query timeout in seconds"
            },
            "database": {
              "type": "string",
              "description": "Database context for the statement"
            },
            "schema": {
              "type": "string",
              "description": "Schema context for the statement"
            },
            "warehouse": {
              "type": "string",
              "description": "Warehouse to execute the statement"
            },
            "role": {
              "type": "string",
              "description": "Role to use for execution"
            },
            "bindings": {
              "type": "object",
              "description": "Parameter bindings for prepared statements"
            },
            "parameters": {
              "type": "object",
              "description": "Session parameters"
            }
          },
          "required": ["statement"]
        },
        "response": {
          "type": "object",
          "properties": {
            "statementHandle": { "type": "string" },
            "statementStatusUrl": { "type": "string" },
            "resultSetMetaData": { "type": "object" },
            "data": { "type": "array" },
            "code": { "type": "string" },
            "sqlState": { "type": "string" },
            "message": { "type": "string" },
            "createdOn": { "type": "integer" }
          }
        }
      },
      "getStatementStatus": {
        "method": "GET",
        "path": "/statements/:statementHandle",
        "description": "Get the status of a statement execution",
        "pathParameters": {
          "statementHandle": {
            "type": "string",
            "description": "Unique identifier for the statement"
          }
        },
        "response": {
          "type": "object",
          "properties": {
            "statementHandle": { "type": "string" },
            "statementStatusUrl": { "type": "string" },
            "statementStatus": { "type": "string" },
            "code": { "type": "string" },
            "sqlState": { "type": "string" },
            "message": { "type": "string" },
            "createdOn": { "type": "integer" }
          }
        }
      },
      "getStatementResult": {
        "method": "GET",
        "path": "/statements/:statementHandle/result",
        "description": "Get the result of a completed statement",
        "pathParameters": {
          "statementHandle": {
            "type": "string",
            "description": "Unique identifier for the statement"
          }
        },
        "queryParameters": {
          "partition": {
            "type": "integer",
            "description": "Result partition index (for large results)"
          }
        },
        "response": {
          "type": "object",
          "properties": {
            "resultSetMetaData": { "type": "object" },
            "data": { "type": "array" },
            "code": { "type": "string" },
            "sqlState": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      },
      "cancelStatement": {
        "method": "POST",
        "path": "/statements/:statementHandle/cancel",
        "description": "Cancel a running statement",
        "pathParameters": {
          "statementHandle": {
            "type": "string",
            "description": "Unique identifier for the statement to cancel"
          }
        },
        "response": {
          "type": "object",
          "properties": {
            "statementHandle": { "type": "string" },
            "statementStatus": { "type": "string" },
            "message": { "type": "string" }
          }
        }
      }
    }
  },

